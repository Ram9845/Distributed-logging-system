# =============================================================================
# Distributed Logging & Monitoring System — Environment Variables
# =============================================================================
# Copy this file to .env and customize values for your environment.

# ---- Application ----
APP_NAME=distributed-logging-system
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logging_db
POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpassword123
DATABASE_URL=postgresql+asyncpg://loguser:logpassword123@postgres:5432/logging_db

# ---- Apache Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_LOGS=service-logs
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DLQ=dead-letter-logs
KAFKA_GROUP_ID=log-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_MAX_RETRIES=3

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=300

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_INSTALL_PLUGINS=grafana-piechart-panel

# ---- Prometheus ----
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# ---- Loki ----
LOKI_HOST=loki
LOKI_PORT=3100

# ---- Kafka UI ----
KAFKA_UI_PORT=8080

# ---- Producer ----
PRODUCER_INTERVAL_MS=500
PRODUCER_BATCH_SIZE=10
PRODUCER_METRICS_PORT=8002

# ---- Consumer ----
CONSUMER_BATCH_SIZE=50
CONSUMER_METRICS_PORT=8001
CONSUMER_POLL_TIMEOUT_MS=1000
